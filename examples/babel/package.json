{
  "name": "babel-example",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "extract": "saykit extract",
    "build": "babel src --extensions .ts,.js --out-dir dist --ignore \"src/**/*.d.ts\"",
    "start": "pnpm build && node dist/main.js",
    "compile": "saykit compile",
    "prebuild": "saykit compile",
    "precheck": "saykit compile",
    "prestart": "saykit compile"
  },
  "dependencies": {
    "saykit": "workspace:^"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@saykit/config": "workspace:^",
    "@saykit/format-po": "workspace:^",
    "@saykit/transform-js": "workspace:^",
    "babel-plugin-saykit": "workspace:^",
    "typescript": "^7.0.2"
  }
}
