{
  // Editor
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "editor.tabSize": 2,

  // Explorer
  "explorer.compactFolders": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, .npmrc",
    "*.ts": "$(capture).test.ts, $(capture).test.tsx",
    "*.tsx": "$(capture).test.tsx",
    "*.po": "$(capture).po.d.ts",
    "*.js": "$(capture).js.map, $(capture).d.ts, $(capture).d.ts.map, $(capture).cjs",
    "*.cjs": "$(capture).cjs.map, $(capture).d.cts, $(capture).d.cts.map",
    "tsconfig.json": "*-env.d.ts"
  },

  // Files
  "files.eol": "\n",
  "files.watcherExclude": {
    "**/.turbo": true,
    "**/.next": true,
    "**/.source": true,
    "**/dist": true
  },
  "search.exclude": {
    "**/.turbo": true,
    "**/.next": true,
    "**/.source": true,
    "**/dist": true
  },

  // TypeScript
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.inlayHints.variableTypes.suppressWhenTypeMatchesName": true,
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" }
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" }
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  // Icons
  "material-icon-theme.files.associations": {
    "saykit.config.ts": "i18n"
  },

  // Better TODO Tree
  "better-todo-tree.general.tags": ["=====", "TODO"],
  "better-todo-tree.highlights.customHighlight": {
    "=====": {
      "type": "whole-line",
      "icon": "bookmark",
      "background": "#00000000",
      "foreground": "#dadada",
      "iconColour": "#dadada",
      "gutterIcon": true,
      "hideFromTree": true
    },
    "TODO": {
      "type": "whole-line",
      "icon": "check",
      "background": "#00000000",
      "foreground": "#ff9900",
      "iconColour": "#ff9900",
      "gutterIcon": true
    }
  },

  // Code Spell Checker
  "cSpell.language": "en,en-GB",
  "cSpell.words": ["saykit", "turbopack", "unplugin"]
}
